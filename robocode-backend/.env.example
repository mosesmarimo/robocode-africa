DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/robocode?schema=public"
AUTH_SECRET="change-me-in-production"
PORT=4100
FRONTEND_ORIGIN="https://robocode.africa"
ROOT_DOMAIN="robocode.africa"

# Platform-default AI model (GLM via Z.ai's OpenAI-compatible endpoint).
# Schools/users can override provider, model and key in Settings.
GLM_API_KEY=""
GLM_MODEL="glm-5.2"
GLM_BASE_URL="https://api.z.ai/api/paas/v4"

# Dev-only: set to "true" to allow the x-tenant header to select a tenant (subdomain
# emulation on localhost). MUST stay unset/false in production.
ALLOW_TENANT_OVERRIDE=""

# Code-runner sandbox (server tier — jailed `docker run`, see docs/sandbox-ops.md).
# Requires Docker on the host + the sandbox/ images built (bash sandbox/build-images.sh).
# Kill-switch: set to "1" (or "true") to disable the server sandbox without a deploy —
# every run request then falls back to the AI-simulated runner. Default empty/off.
RUN_SANDBOX_DISABLED=""

# Publish-to-subdomain (GoDaddy DNS). Leave key/secret empty to stay in
# dry-run mode (every DNS mutation is logged, not sent) — safe default, no
# live creds are provisioned yet. Set GODADDY_OTE="true" to hit GoDaddy's
# OTE (sandbox) API instead of production.
GODADDY_API_KEY=""
GODADDY_API_SECRET=""
GODADDY_OTE=""
# Domains users may publish a project to (comma-separated).
PUBLISH_DOMAINS="robocode.studio,robocode.africa"
# DNS record type/value the wildcard (*.<domain>) should point at — the
# ingress IP (type A) or a CNAME target.
PUBLISH_TARGET_TYPE="A"
PUBLISH_TARGET_VALUE=""
