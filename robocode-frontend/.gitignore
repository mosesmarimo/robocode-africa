# self-hosted WASM sandbox runtimes (regenerated by
# scripts/copy-sandbox-assets.mjs from node_modules on every dev/build —
# see public/sandbox/README.md); multi-MB binaries, not worth committing.
# pyodide-worker.js is hand-authored source (not vendor-copied), so it's
# committed like any other file.
/public/sandbox/*
!/public/sandbox/README.md
!/public/sandbox/pyodide-worker.js

.DS_Store
