# Build-time (inlined into the client bundle by `next build`):
NEXT_PUBLIC_APP_NAME="RoboCode.Africa"
NEXT_PUBLIC_ROOT_DOMAIN="robocode.africa"
NEXT_PUBLIC_API_BASE="/api/v1"
# Domains a project can be published to (mirrors the backend's PUBLISH_DOMAINS).
# The first non-root-tenant domain here (robocode.studio) is a dedicated
# bare-project hosting domain: any subdomain of it always serves a published
# project. robocode.africa doubles as the school-tenant domain — publishing
# there is a fallback that only fires for subdomains with no matching tenant.
NEXT_PUBLIC_PUBLISH_DOMAINS="robocode.studio,robocode.africa"

# Runtime (server-side):
BACKEND_URL="http://127.0.0.1:4100"
PORT=3100
